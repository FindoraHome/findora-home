PUBLIC_HOSTNAME {
	encode zstd gzip
	header {
		>Cache-Control "no-store"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
	header /admin.html X-Robots-Tag "noindex, nofollow"
	header /links.html X-Robots-Tag "noindex, nofollow"

# POCKETBASE_ROUTES

	@webhooks path /integrations/dolly /integrations/instagram
	handle @webhooks {
		uri strip_prefix /integrations
		reverse_proxy 127.0.0.1:8192
	}
	handle /integrations/* {
		respond 404
	}
	handle {
		root * /srv/findora-home/current
		file_server
	}
}
