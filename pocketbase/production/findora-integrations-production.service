[Unit]
Description=Findora Home production Dolly and Instagram webhooks
After=network-online.target findora-pocketbase-production.service
Wants=network-online.target

[Service]
User=findoraprod
Group=findoraprod
Environment=TZ=Europe/Berlin
Environment=FINDORA_SITE_MODE=production
EnvironmentFile=/etc/findora-pocketbase-production/site.env
ExecStart=/opt/findora-integrations/findora-integrations-production
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
